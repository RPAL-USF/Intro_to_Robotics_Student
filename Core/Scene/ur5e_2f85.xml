<mujoco model="ur5e_with_2f85">

  <!-- 1) Combined <compiler>, <option>, <size>
         - Merging from both UR5e and 2F-85 -->
  <compiler angle="radian" meshdir="assets"/>
  <option timestep="0.002" integrator="implicitfast" impratio="20" cone="elliptic" solver="Newton" iterations="100"/>
  <size nkey="1"/>

  <!-- 2) Combined <default> block
         - The UR5e defaults under class="ur5e"
         - The 2F-85 defaults under class="2f85" -->
  <default>

    <!-- UR5e Defaults -->
    <default class="ur5e">
      <material shininess="0.25"/>
      <joint range="-6.28319 6.28319" armature="0.1"/>
      <site size="0.001 0.005 0.005" group="4" rgba="0.5 0.5 0.5 0.3"/>
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="2000" biasprm="0 -2000 -400"
        forcerange="-150 150"/>

      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>

      <default class="size1">
        <general forcerange="-28 28" gainprm="500" biasprm="0 -500 -100"/>
      </default>

      <default class="arm_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>

      <default class="arm_collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
    </default>

    <!-- 2F-85 Defaults -->
    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>

      <default class="driver">
        <joint solreflimit="0.005" solimplimit="0.95 0.99"
               range="0 0.8" armature="0.005" damping="1.0"/>
      </default>

      <default class="follower">
        <joint solreflimit="0.005" solimplimit="0.95 0.99"
               range="-0.872664 0.872664" armature="0.001" damping="0.5"/>
      </default>

      <default class="spring_link">
        <joint springref="2.62" stiffness="0.05"
               range="-0.296706 0.8" armature="0.001" damping="0.5"/>
      </default>

      <default class="coupler">
        <joint solreflimit="0.005" solimplimit="0.95 0.99"
               range="-1.57 0" armature="0.001" damping="0.5"/>
      </default>

      <default class="hand_visual">
        <geom type="mesh" contype="2" conaffinity="1" group="2"/>
      </default>

      <default class="hand_collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom size="0.011 0.004 0.009375" type="box" priority="1"
                friction="1" solref="0.004" solimp="0.95 0.99"
                rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom size="0.011 0.004 0.009375" type="box" priority="1"
                friction="1" solref="0.004" solimp="0.95 0.99"
                rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>

  </default>


  <!-- 3) Combined <asset>
         - UR5e OBJ files
         - 2F-85 STL files
         - Make sure these files exist in "assets/" -->
  <asset>

    <!-- UR5e Materials -->
    <material name="black"     class="ur5e" rgba="0.033 0.033 0.033 1"/>
    <material name="jointgray" class="ur5e" rgba="0.278 0.278 0.278 1"/>
    <material name="linkgray"  class="ur5e" rgba="0.82 0.82 0.82 1"/>
    <material name="urblue"    class="ur5e" rgba="0.49 0.678 0.8 1"/>

    <!-- UR5e Meshes -->
    <mesh name="base_0"      file="base_0.obj"/>
    <mesh name="base_1"      file="base_1.obj"/>
    <mesh name="shoulder_0"  file="shoulder_0.obj"/>
    <mesh name="shoulder_1"  file="shoulder_1.obj"/>
    <mesh name="shoulder_2"  file="shoulder_2.obj"/>
    <mesh name="upperarm_0"  file="upperarm_0.obj"/>
    <mesh name="upperarm_1"  file="upperarm_1.obj"/>
    <mesh name="upperarm_2"  file="upperarm_2.obj"/>
    <mesh name="upperarm_3"  file="upperarm_3.obj"/>
    <mesh name="forearm_0"   file="forearm_0.obj"/>
    <mesh name="forearm_1"   file="forearm_1.obj"/>
    <mesh name="forearm_2"   file="forearm_2.obj"/>
    <mesh name="forearm_3"   file="forearm_3.obj"/>
    <mesh name="wrist1_0"    file="wrist1_0.obj"/>
    <mesh name="wrist1_1"    file="wrist1_1.obj"/>
    <mesh name="wrist1_2"    file="wrist1_2.obj"/>
    <mesh name="wrist2_0"    file="wrist2_0.obj"/>
    <mesh name="wrist2_1"    file="wrist2_1.obj"/>
    <mesh name="wrist2_2"    file="wrist2_2.obj"/>
    <mesh name="wrist3"      file="wrist3.obj"/>

    <!-- Robotiq 2F-85 Materials -->
    <material name="metal"    rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray"     rgba="0.4627 0.4627 0.4627 1"/>
    <!-- "black" is already defined above, so they share it -->

    <!-- Robotiq 2F-85 Meshes -->
    <mesh name="base_mount"     class="2f85" file="base_mount.stl"/>
    <mesh name="base_2f85"      class="2f85" file="base.stl"/>
    <mesh name="driver"         class="2f85" file="driver.stl"/>
    <mesh name="coupler"        class="2f85" file="coupler.stl"/>
    <mesh name="follower"       class="2f85" file="follower.stl"/>
    <mesh name="pad"            class="2f85" file="pad.stl"/>
    <mesh name="silicone_pad"   class="2f85" file="silicone_pad.stl"/>
    <mesh name="spring_link"    class="2f85" file="spring_link.stl"/>

  </asset>


  <!-- 4) Combined <worldbody>
         - UR5e’s entire kinematic chain
         - Attach the 2F-85 at wrist_3_link -->
  <worldbody>
    <!-- UR5e Base Body -->
    <body name="arm_base" childclass="ur5e" quat="0 0 0 -1">
      <inertial pos="0 0 0" mass="4" diaginertia="0.00443333 0.00443333 0.0072"/>
      <geom class="arm_visual" material="black" mesh="base_0"/>
      <geom class="arm_visual" material="jointgray" mesh="base_1"/>

      <body name="shoulder_link" pos="0 0 0.163">
        <inertial pos="0 0 0" mass="3.7" diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint" class="size3" axis="0 0 1"/>
        <geom class="arm_visual" material="urblue" mesh="shoulder_0"/>
        <geom class="arm_visual" material="black" mesh="shoulder_1"/>
        <geom class="arm_visual" material="jointgray" mesh="shoulder_2"/>
        <geom class="arm_collision" size="0.06 0.06" pos="0 0 -0.04"/>

        <body name="upper_arm_link" pos="0 0.138 0" quat="0.707107 0 0.707107 0">
          <inertial pos="0 0 0.2125" mass="8.393" diaginertia="0.133886 0.133886 0.0151074"/>
          <joint name="shoulder_lift_joint" class="size3" pos="0 0 0" axis="0 1 0"/>
          <geom class="arm_visual" material="linkgray" mesh="upperarm_0"/>
          <geom class="arm_visual" material="black" mesh="upperarm_1"/>
          <geom class="arm_visual" material="jointgray" mesh="upperarm_2"/>
          <geom class="arm_visual" material="urblue" mesh="upperarm_3"/>
          <geom class="arm_collision" size="0.06 0.06" pos="0 -0.04 0" quat="0.707107 0.707107 0 0"/>
          <geom class="arm_collision" size="0.05 0.2" pos="0 0 0.2"/>

          <body name="forearm_link" pos="0 -0.131 0.425">
            <inertial pos="0 0 0.196" mass="2.275" diaginertia="0.0311796 0.0311796 0.004095"/>
            <joint name="elbow_joint" class="size3_limited" pos="0 0 0" axis="0 1 0"/>
            <geom class="arm_visual" material="urblue" mesh="forearm_0"/>
            <geom class="arm_visual" material="linkgray" mesh="forearm_1"/>
            <geom class="arm_visual" material="black" mesh="forearm_2"/>
            <geom class="arm_visual" material="jointgray" mesh="forearm_3"/>
            <geom class="arm_collision" size="0.055 0.06" pos="0 0.08 0" quat="0.707107 0.707107 0 0"/>
            <geom class="arm_collision" size="0.038 0.19" pos="0 0 0.2"/>

            <body name="wrist_1_link" pos="0 0 0.392" quat="0.707107 0 0.707107 0">
              <inertial pos="0 0.127 0" mass="1.219"
                        diaginertia="0.0025599 0.0025599 0.0021942"/>
              <joint name="wrist_1_joint" class="size1" pos="0 0 0" axis="0 1 0"/>
              <geom class="arm_visual" material="black" mesh="wrist1_0"/>
              <geom class="arm_visual" material="urblue" mesh="wrist1_1"/>
              <geom class="arm_visual" material="jointgray" mesh="wrist1_2"/>
              <geom class="arm_collision" size="0.04 0.07" pos="0 0.05 0" quat="0.707107 0.707107 0 0"/>

              <body name="wrist_2_link" pos="0 0.127 0">
                <inertial pos="0 0 0.1" mass="1.219"
                          diaginertia="0.0025599 0.0025599 0.0021942"/>
                <joint name="wrist_2_joint" class="size1" pos="0 0 0" axis="0 0 1"/>
                <geom class="arm_visual" material="black" mesh="wrist2_0"/>
                <geom class="arm_visual" material="urblue" mesh="wrist2_1"/>
                <geom class="arm_visual" material="jointgray" mesh="wrist2_2"/>
                <geom class="arm_collision" size="0.04 0.06" pos="0 0 0.04"/>
                <geom class="arm_collision" size="0.04 0.04" pos="0 0.02 0.1" quat="0.707107 0.707107 0 0"/>

                <body name="wrist_3_link" pos="0 0 0.1">
                  <inertial pos="0 0.0771683 0" quat="0.707107 0 0 0.707107"
                            mass="0.1889"
                            diaginertia="0.000132134 9.90863e-05 9.90863e-05"/>
                  <joint name="wrist_3_joint" class="size1"
                         pos="0 0 0" axis="0 1 0"/>
                  <geom class="arm_visual" material="linkgray" mesh="wrist3"/>
                  <geom class="eef_collision" size="0.04 0.02"
                        pos="0 0.08 0" quat="0.707107 0.707107 0 0"/>
                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>

                  <!-- Here we attach the 2F-85. 
                       Adjust pos/quat if you need to rotate/shift the gripper. -->
                  <body name="robotiq_base_mount" childclass="2f85"
                        pos="0 0.1 0.0" quat="0.707107 -0.707107 0 0">
                    <geom class="hand_visual" material="black" mesh="base_mount"/>
                    <geom class="hand_collision" mesh="base_mount"/>

                    <!-- The "base" body of the 2F-85 
                         (renamed from the original second <mujoco>). -->
                    <body name="hand_base" pos="0 0 0.0038" quat="0.707107 0 0 -0.707107">
                      <inertial pos="0 -2.70394e-05 0.0354675"
                                quat="0.999999 -0.00152849 0 0"
                                mass="0.777441"
                                diaginertia="0.000260285 0.000225381 0.000152708"/>
                      <geom class="hand_visual" material="black" mesh="base_2f85"/>
                      <geom class="hand_collision" mesh="base_2f85"/>
                      <site name="pinch" pos="0 0 0.145" group="5" rgba="0.9 0.9 0.9 1"/>

                      <!-- Right Driver -->
                      <body name="right_driver" pos="0 0.0306011 0.054904">
                        <inertial pos="2.96931e-12 0.0177547 0.00107314"
                                  quat="0.681301 0.732003 0 0"
                                  mass="0.00899563"
                                  diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                        <joint name="right_driver_joint" class="driver"
                               pos="0 0 0" axis="1 0 0"/>
                        <geom class="hand_visual" material="gray" mesh="driver"/>
                        <geom class="hand_collision" mesh="driver"/>

                        <body name="right_coupler" pos="0 0.0315 -0.0041">
                          <inertial pos="0 0.00301209 0.0232175"
                                    quat="0.705636 -0.0455904 0.0455904 0.705636"
                                    mass="0.0140974"
                                    diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                          <joint name="right_coupler_joint" class="coupler"
                                 pos="0 0 0" axis="1 0 0"/>
                          <geom class="hand_visual" material="black" mesh="coupler"/>
                          <geom class="hand_collision" mesh="coupler"/>
                        </body>
                      </body>

                      <!-- Right Spring Link -->
                      <body name="right_spring_link" pos="0 0.0132 0.0609">
                        <inertial pos="-8.65005e-09 0.0181624 0.0212658"
                                  quat="0.663403 -0.244737 0.244737 0.663403"
                                  mass="0.0221642"
                                  diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                        <joint name="right_spring_link_joint" class="spring_link"
                               pos="0 0 0" axis="1 0 0" springref="2.62"/>
                        <geom class="hand_visual" material="black" mesh="spring_link"/>
                        <geom class="hand_collision" mesh="spring_link"/>

                        <body name="right_follower" pos="0 0.055 0.0375">
                          <inertial pos="0 -0.011046 0.0124786"
                                    quat="0.986437 0.164143 0 0"
                                    mass="0.0125222"
                                    diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                          <joint name="right_follower_joint" class="follower"
                                 pos="0 -0.018 0.0065" axis="1 0 0"/>
                          <geom class="hand_visual" material="black" mesh="follower"/>
                          <geom class="hand_collision" mesh="follower"/>

                          <body name="right_pad" pos="0 -0.0189 0.01352">
                            <inertial pos="0 -0.0025 0.0185"
                                      quat="0.707107 0 0 0.707107"
                                      mass="0.0035"
                                      diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                            <geom name="right_pad1" class="pad_box1"
                                  pos="0 -0.0026 0.028125" mass="0"/>
                            <geom name="right_pad2" class="pad_box2"
                                  pos="0 -0.0026 0.009375" mass="0"/>
                            <geom class="hand_visual" mesh="pad"/>
                            <body name="right_silicone_pad">
                              <geom class="hand_visual" material="black" mesh="silicone_pad"/>
                            </body>
                          </body>
                        </body>
                      </body>

                      <!-- Left Driver -->
                      <body name="left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
                        <inertial pos="0 0.0177547 0.00107314"
                                  quat="0.681301 0.732003 0 0"
                                  mass="0.00899563"
                                  diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                        <joint name="left_driver_joint" class="driver"
                               pos="0 0 0" axis="1 0 0"/>
                        <geom class="hand_visual" material="gray" mesh="driver"/>
                        <geom class="hand_collision" mesh="driver"/>
                        <body name="left_coupler" pos="0 0.0315 -0.0041">
                          <inertial pos="0 0.00301209 0.0232175"
                                    quat="0.705636 -0.0455904 0.0455904 0.705636"
                                    mass="0.0140974"
                                    diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                          <joint name="left_coupler_joint" class="coupler"
                                 pos="0 0 0" axis="1 0 0"/>
                          <geom class="hand_visual" material="black" mesh="coupler"/>
                          <geom class="hand_collision" mesh="coupler"/>
                        </body>
                      </body>

                      <!-- Left Spring Link -->
                      <body name="left_spring_link" pos="0 -0.0132 0.0609" quat="0 0 0 1">
                        <inertial pos="-8.65005e-09 0.0181624 0.0212658"
                                  quat="0.663403 -0.244737 0.244737 0.663403"
                                  mass="0.0221642"
                                  diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                        <joint name="left_spring_link_joint" class="spring_link"
                               pos="0 0 0" axis="1 0 0" springref="2.62"/>
                        <geom class="hand_visual" material="black" mesh="spring_link"/>
                        <geom class="hand_collision" mesh="spring_link"/>

                        <body name="left_follower" pos="0 0.055 0.0375">
                          <inertial pos="0 -0.011046 0.0124786"
                                    quat="0.986437 0.164143 0 0"
                                    mass="0.0125222"
                                    diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                          <joint name="left_follower_joint" class="follower"
                                 pos="0 -0.018 0.0065" axis="1 0 0"/>
                          <geom class="hand_visual" material="black" mesh="follower"/>
                          <geom class="hand_collision" mesh="follower"/>

                          <body name="left_pad" pos="0 -0.0189 0.01352">
                            <inertial pos="0 -0.0025 0.0185"
                                      quat="0.707107 0 0 0.707107"
                                      mass="0.0035"
                                      diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                            <geom name="left_pad1"  class="pad_box1" pos="0 -0.0026 0.028125" mass="0"/>
                            <geom name="left_pad2"  class="pad_box2" pos="0 -0.0026 0.009375" mass="0"/>
                            <geom class="hand_visual" mesh="pad"/>
                            <body name="left_silicone_pad">
                              <geom class="hand_visual" material="black" mesh="silicone_pad"/>
                            </body>
                          </body>
                        </body>
                      </body>

                    </body> <!-- end of "hand base" -->
                  </body> <!-- end of robotiq_base_mount -->
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body> <!-- end of "arm base" -->
  </worldbody>


  <!-- 5) Combined <actuator> from both UR5e & 2F-85 -->
  <actuator>
    <!-- UR5e actuators -->
    <general name="shoulder_pan"   class="size3"         joint="shoulder_pan_joint"/>
    <general name="shoulder_lift"  class="size3"         joint="shoulder_lift_joint"/>
    <general name="elbow"          class="size3_limited" joint="elbow_joint"/>
    <general name="wrist_1"        class="size1"         joint="wrist_1_joint"/>
    <general name="wrist_2"        class="size1"         joint="wrist_2_joint"/>
    <general name="wrist_3"        class="size1"         joint="wrist_3_joint"/>

    <!-- 2F-85 actuator (drives both fingers via tendon) -->
    <general name="fingers_actuator" class="2f85" tendon="split"
             ctrlrange="0 255" forcerange="-5 5"
             gainprm="0.313725" biasprm="0 -100 -10"/>
  </actuator>

  <!-- 7) Robotiq 2F-85 <contact>, <equality>, <tendon> for finger coupling -->
  <contact>
    <exclude body1="hand_base" body2="right_driver"/>
    <exclude body1="hand_base" body2="right_spring_link"/>
    <exclude body1="hand_base" body2="left_driver"/>
    <exclude body1="hand_base" body2="left_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler"  body2="left_follower"/>
  </contact>

  <equality>
    <connect body1="right_follower" body2="right_coupler"
             anchor="0 0 0" solref="0.005" solimp="0.95 0.99"/>
    <connect body1="left_follower"  body2="left_coupler"
             anchor="0 0 0" solref="0.005" solimp="0.95 0.99"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint"
           polycoef="0 1 0 0 0" solref="0.005" solimp="0.95 0.99"/>
  </equality>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint"  coef="0.5"/>
    </fixed>
  </tendon>

</mujoco>
